@echo off
setlocal
cd /d "%~dp0.."
set TOOL=%~dp0
set PYTHONIOENCODING=utf-8

echo [1/8] Creating editable Basit 7px project (ASCII + Arabic)...
java -cp GLCDFontCreator2 BuildArabicFont lib\DMDESP\fonts\BasitFont7.h "%TOOL%BasitFont7.ftsd" || exit /b 1
echo [2/8] Creating editable Basit 7px Indic project...
java -cp GLCDFontCreator2 BuildArabicFont lib\DMDESP\fonts\BasitFont7Indic.h "%TOOL%BasitFont7Indic.ftsd" || exit /b 1
echo [3/8] Creating editable Basit 16px project (ASCII + Arabic)...
java -cp GLCDFontCreator2 BuildArabicFont lib\DMDESP\fonts\BasitFont16.h "%TOOL%BasitFont16.ftsd" || exit /b 1
echo [4/8] Creating editable Basit 16px Indic project...
java -cp GLCDFontCreator2 BuildArabicFont lib\DMDESP\fonts\BasitFont16Indic.h "%TOOL%BasitFont16Indic.ftsd" || exit /b 1
echo [5/8] Creating editable Tahoma 7px project (ASCII + Arabic)...
java -cp GLCDFontCreator2 BuildArabicFont lib\DMDESP\fonts\Tahoma7.h "%TOOL%Fonts\Tahoma7.ftsd" || exit /b 1
echo [6/8] Creating editable Tahoma 7px Indic project...
java -cp GLCDFontCreator2 BuildArabicFont lib\DMDESP\fonts\Tahoma7Indic.h "%TOOL%Fonts\Tahoma7Indic.ftsd" || exit /b 1
echo [7/8] Creating editable Tahoma Bold 16px project (ASCII + Arabic)...
java -cp GLCDFontCreator2 BuildArabicFont lib\DMDESP\fonts\TahomaBold16.h "%TOOL%Fonts\TahomaBold16.ftsd" || exit /b 1
echo [8/8] Creating editable Tahoma Bold 16px Indic project...
java -cp GLCDFontCreator2 BuildArabicFont lib\DMDESP\fonts\TahomaBold16Indic.h "%TOOL%Fonts\TahomaBold16Indic.ftsd" || exit /b 1
echo [9] Creating editable P10 Tahoma Bold 8px project...
java -cp GLCDFontCreator2 BuildArabicFont lib\DMDESP\fonts\TahomaP10_8_Bold.h "%TOOL%Fonts\TahomaP10_8_Bold.ftsd" || exit /b 1
echo [10] Creating editable P10 Tahoma Bold 8px Indic project...
java -cp GLCDFontCreator2 BuildArabicFont lib\DMDESP\fonts\TahomaP10_8_BoldIndic.h "%TOOL%Fonts\TahomaP10_8_BoldIndic.ftsd" || exit /b 1
echo [11] Creating editable P10 Tahoma Medium 8px project...
java -cp GLCDFontCreator2 BuildArabicFont lib\DMDESP\fonts\TahomaP10_8_Medium.h "%TOOL%Fonts\TahomaP10_8_Medium.ftsd" || exit /b 1
echo [12] Creating editable P10 Tahoma Medium 8px Indic project...
java -cp GLCDFontCreator2 BuildArabicFont lib\DMDESP\fonts\TahomaP10_8_MediumIndic.h "%TOOL%Fonts\TahomaP10_8_MediumIndic.ftsd" || exit /b 1

echo Done. Open any .ftsd project with start.bat.
endlocal
